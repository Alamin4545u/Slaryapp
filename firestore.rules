rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admins must be provisioned manually in Firebase Console:
    // admins/{AUTH_UID} => { active: true }
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /siteSettings/{docId} {
      allow read: if docId == "public";
      allow create, update, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}